+// Warps samples to a Gaussian of unit standard deviation, cut off at -3 and 3: the inverse of its distribution,
+// by the inverse error function.
+// Separable: run once for x and y dimensions.
+// Input: samples in [0, 1].
+// Output: samples in [-3, 3]
+inline float erfinvApprox(float x)
+{
+    // M. Giles, "Approximating the erfinv function", GPU Computing Gems Jade Edition (2011): single precision.
+    float w = -log((1.0f - x) * (1.0f + x));
+    float p;
+    if (w < 5.0f) {
+        w = w - 2.5f;
+        p = 2.81022636e-08f;
+        p = 3.43273939e-07f + p*w;
+        p = -3.5233877e-06f + p*w;
+        p = -4.39150654e-06f + p*w;
+        p = 0.00021858087f + p*w;
+        p = -0.00125372503f + p*w;
+        p = -0.00417768164f + p*w;
+        p = 0.246640727f + p*w;
+        p = 1.50140941f + p*w;
+    } else {
+        w = sqrt(w) - 3.0f;
+        p = -0.000200214257f;
+        p = 0.000100950558f + p*w;
+        p = 0.00134934322f + p*w;
+        p = -0.00367342844f + p*w;
+        p = 0.00573950773f + p*w;
+        p = -0.0076224613f + p*w;
+        p = 0.00943887047f + p*w;
+        p = 1.00167406f + p*w;
+        p = 2.83297682f + p*w;
+    }
+    return p * x;
+}
+
+export void PBR_gaussianWarp(uniform unsigned int size,
+                             uniform float samples[])
+{
+    // erf(3 / sqrt(2)): the share of the Gaussian within three standard deviations.
+    const uniform float within = 0.99730020f;
+    foreach (i = 0 ... size) {
+        const float r = samples[i];
+        const float e = clamp((2.0f * r - 1.0f) * within, -0.9999999f, 0.9999999f);
+        samples[i] = clamp(1.41421356f * erfinvApprox(e), -3.0f, 3.0f);
+    }
+}
+
+// Warps samples to a tent filter.
+// Separable: run once for x and y dimensions.
+// Input: samples in [0, 1].
+// Output: samples in [-1, 1]
+export void PBR_triangleWarp(uniform unsigned int size,
+                             uniform float samples[])
+{
+    foreach (i = 0 ... size) {
+        const float r = samples[i];
+        samples[i] = r < 0.5f ? sqrt(2.0f * r) - 1.0f : 1.0f - sqrt(2.0f * (1.0f - r));
+    }
+}
+
+// Warps samples to the 4-term Blackman-Harris window
+//   w(t) = a0 - a1 cos(2 pi t) + a2 cos(4 pi t) - a3 cos(6 pi t), t in [0, 1],
+// by solving for the place where its integral reaches r of the whole: Newton's method, kept within a bracket that
+// halves whenever a step would leave it.
+// Separable: run once for x and y dimensions.
+// Input: samples in [0, 1].
+// Output: samples in [-1, 1]
+export void PBR_blackmanHarrisWarp(uniform unsigned int size,
+                                   uniform float samples[])
+{
+    const uniform float a0 = 0.35875f, a1 = 0.48829f, a2 = 0.14128f, a3 = 0.01168f;
+    foreach (i = 0 ... size) {
+        const float target = samples[i] * a0;
+        float low = 0.0f, high = 1.0f, t = samples[i];
+        for (uniform int j = 0; j < 12; ++j) {
+            const float c = a0 * t - a1 * sin(2.0f * PI * t) / (2.0f * PI) + a2 * sin(4.0f * PI * t) / (4.0f * PI)
+                          - a3 * sin(6.0f * PI * t) / (6.0f * PI) - target;
+            if (c > 0.0f) high = t; else low = t;
+            const float w = a0 - a1 * cos(2.0f * PI * t) + a2 * cos(4.0f * PI * t) - a3 * cos(6.0f * PI * t);
+            float next = w > 1e-6f ? t - c / w : 0.5f * (low + high);
+            if (next <= low || next >= high) next = 0.5f * (low + high);
+            t = next;
+        }
+        samples[i] = 2.0f * t - 1.0f;
+    }
+}
