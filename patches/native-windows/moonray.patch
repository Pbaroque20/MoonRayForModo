+        const scene_rdl2::fb_util::FloatBuffer &weights = mFilm->getWeightBuffer();
+        const scene_rdl2::fb_util::Tiler &tiler = mFilm->getTiler();
+        std::vector<float> score(count, 0.f);
+        double total = 0.0;
+        std::vector<float> above;
+        for (size_t t = 0; t < count; ++t) {
