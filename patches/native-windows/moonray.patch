+    // Modo: on a toon material, how far the smooth surface the corner normals describe lies above the flat
+    // face at P: P moved up to the tangent planes at the corners, weighted by its barycentric coordinates
+    // (Hanika, "Hacking the Shadow Terminator", 2021). Shadow rays near the terminator start there.
+    void setModoSmoothOffset(const scene_rdl2::math::Vec3f &P,
+                             const scene_rdl2::math::Vec3f &p1, const scene_rdl2::math::Vec3f &p2,
+                             const scene_rdl2::math::Vec3f &p3, const scene_rdl2::math::Vec3f &n1,
+                             const scene_rdl2::math::Vec3f &n2, const scene_rdl2::math::Vec3f &n3,
+                             float w1, float w2, float w3)
+    {
+        if (!mMaterial || mMaterial->getSceneClass().getName() != "DwaToonMaterial") return;
+        scene_rdl2::math::Vec3f offset(0.0f);
+        const auto lift = [&](const scene_rdl2::math::Vec3f &corner, const scene_rdl2::math::Vec3f &n, float weight) {
+            const scene_rdl2::math::Vec3f unit = scene_rdl2::math::normalize(n);
+            const float below = scene_rdl2::math::dot(P - corner, unit);
+            if (below < 0.0f) offset = offset - (weight * below) * unit;
+        };
+        lift(p1, n1, w1); lift(p2, n2, w2); lift(p3, n3, w3);
+        if (scene_rdl2::math::isFinite(offset)) mModoSmoothOffset = offset;
+    }
+    finline const scene_rdl2::math::Vec3f &getModoSmoothOffset() const { return mModoSmoothOffset; }
