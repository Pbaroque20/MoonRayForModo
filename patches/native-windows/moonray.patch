+// or behind the face, fading out by the time it is 0.1 (in cosine) above it.
+static finline scene_rdl2::math::Vec3f
+modoShadowOrigin(const shading::Intersection &isect, const scene_rdl2::math::Vec3f &P, const scene_rdl2::math::Vec3f &wi)
+{
+    const scene_rdl2::math::Vec3f &offset = isect.getModoSmoothOffset();
+    const scene_rdl2::math::Vec3f &N = isect.getN();
+    if (scene_rdl2::math::dot(offset, offset) == 0.0f || scene_rdl2::math::dot(N, wi) <= 0.0f ||
