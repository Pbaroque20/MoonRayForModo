diff --git a/lib/rendering/pbr/cmake/ConcatenateBinaryFiles.py b/lib/rendering/pbr/cmake/ConcatenateBinaryFiles.py
new file mode 100644
--- /dev/null
+++ b/lib/rendering/pbr/cmake/ConcatenateBinaryFiles.py
@@ -0,0 +1,12 @@
+# Copyright 2026 MoonRayForModo contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Stream binary chunks, including files whose paths contain spaces."""
+import shutil
+import sys
+from pathlib import Path
+
+output = Path(sys.argv[1])
+with output.open('wb') as destination:
+    for name in sys.argv[2:]:
+        with Path(name).open('rb') as source:
+            shutil.copyfileobj(source, destination, 1024 * 1024)
diff --git a/lib/rendering/pbr/core/ModoCryptoOnce.h b/lib/rendering/pbr/core/ModoCryptoOnce.h
new file mode 100644
--- /dev/null
+++ b/lib/rendering/pbr/core/ModoCryptoOnce.h
@@ -0,0 +1,31 @@
+// Modo: each Cryptomatte sample counted once in vector and XPU modes (tools/port_crypto_once.py).
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+
+namespace moonray {
+namespace pbr {
+
+/// True when MoonRay was started with MOONRAY_MODO_CRYPTO_ONCE=1. Read once.
+inline bool modoCryptoOnce()
+{
+    static const bool on = [] {
+        const char *value = std::getenv("MOONRAY_MODO_CRYPTO_ONCE");
+        return value && value[0] == '1';
+    }();
+    return on;
+}
+
+/// Whether this is the path's first entry: with the switch on, read and cleared at once, so that only one thread
+/// sees it set; without it, read as MoonRay does (the caller clears it).
+inline bool modoTakeFirstSample(uint8_t &first)
+{
+    if (modoCryptoOnce()) {
+        return __atomic_exchange_n(&first, uint8_t(0), __ATOMIC_ACQ_REL) != 0;
+    }
+    return first != 0;
+}
+
+} // namespace pbr
+} // namespace moonray
