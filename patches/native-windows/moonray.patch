 }
 
+void
+BsdfBuilder_addSchlickReflection(
+        varying BsdfBuilder& builder,
+        const varying Vec3f& normal,
+        const varying Color& reflectance,
+        const varying float roughness,
+        const uniform bool mirror,
+        const uniform int label)
+{
+    varying BsdfBuilderImpl& me = *builder.mImpl;
+    cif (!testForVisibility(me, 1.0f, BSDFBUILDER_PHYSICAL)) { return; }
+    cif (testLobeLimitExceeded(me)) { return; }
+    const varying Vec3f N = Intersection_adaptNormal(asAnIntersection(*(me.mState)), normal);
+    varying BsdfLobe * uniform lobe;
+    if (mirror) {
+        lobe = (varying BsdfLobe * uniform) Arena_alloc(me.mTls->mArena, sizeof(varying MirrorReflectionBsdfLobe));
+        MirrorReflectionBsdfLobe_init((varying MirrorReflectionBsdfLobe * uniform) lobe, N);
+    } else {
+        lobe = (varying BsdfLobe * uniform) Arena_alloc(me.mTls->mArena, sizeof(varying GGXCookTorranceBsdfLobe));
+        GGXCookTorranceBsdfLobe_init((varying GGXCookTorranceBsdfLobe * uniform) lobe, N, roughness);
+    }
+    varying SchlickFresnel * uniform schlick = (varying SchlickFresnel * uniform)
+        Arena_alloc(me.mTls->mArena, sizeof(varying SchlickFresnel));
+    SchlickFresnel_init(schlick, reflectance, 1.0f);
+    varying Fresnel * uniform fresnel = (varying Fresnel * uniform) schlick;
+    BsdfLobe_setFresnel(lobe, fresnel);
+    BsdfLobe_setScale(lobe, sWhite * me.mCurrentTransmittance);
+    lobe = placeUnderPreviousLobes(me, lobe);
+    varying SimpleAttenuator * uniform atten = (varying SimpleAttenuator * uniform)
+        Arena_alloc(me.mTls->mArena, sizeof(varying SimpleAttenuator));
+    SimpleAttenuator_init(atten, me.mTls->mArena, N, roughness, fresnel);
+    stageAttenuator(me, (varying LobeAttenuator * uniform) atten);
+    BsdfLobe_setLabel(lobe, label);
+    Bsdf_addLobe(me.mBsdf, lobe);
+    accumulateAttenuation(me);
+}
+
 void
 BsdfBuilder_addMicrofacetIsotropicBRDF(
         varying BsdfBuilder& builder,
