+// Modo: a toon material's shadow ray toward a light near the terminator starts from the smooth surface, not the
+// flat face (as modoShadowOrigin in PathIntegratorMultiSampler.cc).
+inline varying Vec3f
+modoShadowOrigin(const varying Intersection &isect, const varying Vec3f &P, const varying Vec3f &wi)
+{
+    const varying Vec3f offset = isect.mModoSmoothOffset;
+    const varying Vec3f N = isect.mN;
+    varying Vec3f Ng = isect.mNg;
+    if (dot(offset, offset) == 0.0f || dot(N, wi) <= 0.0f || dot(offset, N) < 0.0f) {
+        return P;
+    }
+    if (dot(N, Ng) < 0.0f) {
+        Ng = Ng * -1.0f;
+    }
+    const varying float amount = clamp(1.0f - dot(Ng, wi) / 0.1f, 0.0f, 1.0f);
+    return P + offset * amount;
+}
