+// A Gaussian cut off at three standard deviations either side: at a pixel filter width of 3, a
+// standard deviation of half a pixel.
+class GaussianPixelFilter final : public PixelFilter
+{
+public:
+    explicit GaussianPixelFilter(float footprint) :
+        PixelFilter(footprint)
+    {
+    }
+
+private:
+    void applyFilter(utype dataSize, float* data) const override
+    {
+        ispc::PBR_gaussianWarp(dataSize, data);
+    }
+
+    void applyOffset(utype dataSize, float* data) const override
+    {
+        const float filterFootprint = 6.0f;
+        const float widthMultiplier = getDesiredFootprint()/filterFootprint;
+
+        ispc::PBR_filterOffset(dataSize, data, widthMultiplier);
+    }
+};
+
+// A tent: highest in the middle, falling straight to nothing at the edge of the filter width.
+class TrianglePixelFilter final : public PixelFilter
+{
+public:
+    explicit TrianglePixelFilter(float footprint) :
+        PixelFilter(footprint)
+    {
+    }
+
+private:
+    void applyFilter(utype dataSize, float* data) const override
+    {
+        ispc::PBR_triangleWarp(dataSize, data);
+    }
+
+    void applyOffset(utype dataSize, float* data) const override
+    {
+        const float filterFootprint = 2.0f;
+        const float widthMultiplier = getDesiredFootprint()/filterFootprint;
+
+        ispc::PBR_filterOffset(dataSize, data, widthMultiplier);
+    }
+};
+
+// The 4-term Blackman-Harris window across the filter width: positive throughout, a little
+// sharper than the Gaussian for the same width.
+class BlackmanHarrisPixelFilter final : public PixelFilter
+{
+public:
+    explicit BlackmanHarrisPixelFilter(float footprint) :
+        PixelFilter(footprint)
+    {
+    }
+
+private:
+    void applyFilter(utype dataSize, float* data) const override
+    {
+        ispc::PBR_blackmanHarrisWarp(dataSize, data);
+    }
+
+    void applyOffset(utype dataSize, float* data) const override
+    {
+        const float filterFootprint = 2.0f;
+        const float widthMultiplier = getDesiredFootprint()/filterFootprint;
+
+        ispc::PBR_filterOffset(dataSize, data, widthMultiplier);
+    }
+};
