 inline bool isAbsolute(const std::string& filePath)
 {
+#ifdef _WIN32
+    // libstdc++ on MinGW does not classify UNC paths as absolute.
+    if (filePath.size() > 2 && (filePath[0] == '\\' || filePath[0] == '/') &&
+        filePath[1] == filePath[0]) {
+        const auto share = filePath.find_first_of("/\\", 2);
+        return share != std::string::npos && share > 2 && share + 1 < filePath.size() &&
+               filePath[share + 1] != '/' && filePath[share + 1] != '\\';
+    }
+    return std::filesystem::path(filePath).is_absolute();
+#else
     return !filePath.empty() && filePath[0] == '/';
+#endif
 }
 
