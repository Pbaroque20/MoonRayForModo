+#ifdef _WIN32
+    if (GetActiveProcessorGroupCount() != 1) { errMsg = "Only one Windows processor group is supported"; return false; }
+    DWORD length = 0;
+    GetLogicalProcessorInformationEx(RelationProcessorPackage, nullptr, &length);
+    std::vector<unsigned char> buffer(length);
+    if (!length || !GetLogicalProcessorInformationEx(RelationProcessorPackage,
+            reinterpret_cast<PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX>(buffer.data()), &length)) {
+        errMsg = "Cannot query Windows CPU sockets"; return false;
+    }
+    unsigned offset = 0;
+    int socket = 0;
+    while (offset < length) {
+        const auto* info = reinterpret_cast<PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX>(buffer.data() + offset);
+        if (!info->Size) { errMsg = "Invalid Windows CPU topology"; return false; }
+        for (unsigned group = 0; group < info->Processor.GroupCount; ++group)
+            for (unsigned cpu = 0; cpu < 64; ++cpu)
+                if (info->Processor.GroupMask[group].Mask & (KAFFINITY(1) << cpu)) {
+                    cpuIdWorkTbl.push_back(cpu); socketIdWorkTbl.push_back(socket);
+                }
+        offset += info->Size;
+        ++socket;
+    }
+    return true;
+#else
     std::ifstream ifs("/proc/cpuinfo");
     if (!ifs) {
         errMsg = "Could not open /proc/cpuinfo";
@@ -416,6 +443,7 @@ CpuSocketUtil::setupLocalhostCpuInfo(std::vector<int>& cpuIdWorkTbl,
