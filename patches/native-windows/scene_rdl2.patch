 namespace scene_rdl2 {
+#ifdef _WIN32
+// The initial Windows port supports a single processor group (up to 64 CPUs).
+using cpu_set_t = std::uint64_t;
+constexpr unsigned CPU_SETSIZE = 64;
+inline void CPU_ZERO(cpu_set_t* a) { *a = 0; }
+inline void CPU_SET(unsigned i, cpu_set_t* a) { if (i < 64) *a |= std::uint64_t(1) << i; }
+inline bool CPU_EQUAL(const cpu_set_t* a, const cpu_set_t* b) { return *a == *b; }
+inline bool CPU_ISSET(unsigned i, const cpu_set_t* a) { return i < 64 && (*a & (std::uint64_t(1) << i)); }
+inline void CPU_AND(cpu_set_t* a, const cpu_set_t* b, const cpu_set_t* c) { *a = *b & *c; }
+inline void CPU_OR(cpu_set_t* a, const cpu_set_t* b, const cpu_set_t* c) { *a = *b | *c; }
+inline unsigned CPU_COUNT(const cpu_set_t* a) {
+    auto bits = *a;
+    unsigned count = 0;
+    while (bits) { bits &= bits - 1; ++count; }
+    return count;
+}
+#endif
 #ifdef __APPLE__
 #define CPU_ZERO(a)
 #define CPU_SET(a, b)
