diff --git a/lib/common/platform/WindowsEndian.h b/lib/common/platform/WindowsEndian.h
new file mode 100644
--- /dev/null
+++ b/lib/common/platform/WindowsEndian.h
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <boost/endian/conversion.hpp>
+#include <cstdint>
+
+// Fixed-width conversions for the Windows port; retain the existing wire format.
+inline uint16_t htobe16(uint16_t x) { return boost::endian::native_to_big(x); }
+inline uint32_t htobe32(uint32_t x) { return boost::endian::native_to_big(x); }
+inline uint64_t htobe64(uint64_t x) { return boost::endian::native_to_big(x); }
+inline uint16_t be16toh(uint16_t x) { return boost::endian::big_to_native(x); }
+inline uint32_t be32toh(uint32_t x) { return boost::endian::big_to_native(x); }
+inline uint64_t be64toh(uint64_t x) { return boost::endian::big_to_native(x); }
+inline uint16_t htole16(uint16_t x) { return boost::endian::native_to_little(x); }
+inline uint32_t htole32(uint32_t x) { return boost::endian::native_to_little(x); }
+inline uint64_t htole64(uint64_t x) { return boost::endian::native_to_little(x); }
+inline uint16_t le16toh(uint16_t x) { return boost::endian::little_to_native(x); }
+inline uint32_t le32toh(uint32_t x) { return boost::endian::little_to_native(x); }
+inline uint64_t le64toh(uint64_t x) { return boost::endian::little_to_native(x); }
